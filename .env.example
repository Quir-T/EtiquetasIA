# Application
APP_NAME=Anamnesis API
LOG_LEVEL=INFO
API_KEY_READ=desarrollo
API_KEY_WRITE=desarrollo
CORS_ORIGINS=http://localhost,http://127.0.0.1
MAX_TEXT_LENGTH=12000
NLP_PROVIDER_TIMEOUT_SECONDS=10
PROMPT_VERSION=v1
NLP_PROVIDER=google

# Labels catalog source and startup snapshot behavior
LABELS_CATALOG_SOURCE=external_db
LABELS_CATALOG_EXTERNAL_DSN=
LABELS_CATALOG_EXTERNAL_QUERY=SELECT name, description FROM labels_catalog
LABELS_CATALOG_SNAPSHOT_PATH=src/infrastructure/config/labels_catalog.json

# XAMPP MariaDB mock example (app running in Docker container)
# Uses ET_DESC only, projected as the expected name/description shape.
LABELS_CATALOG_EXTERNAL_DSN=mysql+pymysql://labels_api:labels_api@host.docker.internal:3306/mock_catalogo?charset=latin1
LABELS_CATALOG_EXTERNAL_QUERY=SELECT TRIM(ET_DESC) AS name, '' AS description FROM etiquetas WHERE ET_DESC IS NOT NULL AND TRIM(ET_DESC) <> '' AND (ET_BAJA = 0 OR ET_BAJA IS NULL)
LABELS_CATALOG_SNAPSHOT_PATH=/data/labels_catalog.json

# XAMPP MariaDB mock example (app running locally, not inside Docker)
# LABELS_CATALOG_EXTERNAL_DSN=mysql+pymysql://root@localhost/mock_catalogo?unix_socket=/opt/lampp/var/mysql/mysql.sock&charset=latin1

# Database
DATABASE_DSN=postgresql+psycopg://app:app@postgres:5432/anamnesis_db
DB_SSL_MODE=disable
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# Docker entrypoint migrations
DB_MIGRATION_MAX_RETRIES=20
DB_MIGRATION_RETRY_DELAY_SECONDS=3

# Anonymizer
# Default example keeps the legacy implementation for the current local flow.
# Alternative available in the repo:
# ANONYMIZER_MODULE=src.infrastructure.anonymizer.presidio_anonymizer
# ANONYMIZER_CLASS=PresidioTransformerAnonymizer
ANONYMIZER_MODULE=src.infrastructure.anonymizer.anonymizer
ANONYMIZER_CLASS=LegacySpacyAnonymizer

# Google NLP provider
GOOGLE_NLP_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GOOGLE_NLP_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=
GOOGLE_NLP_MAX_RETRIES=3
GOOGLE_NLP_BASE_BACKOFF_SECONDS=1.0
GOOGLE_NLP_MAX_BACKOFF_SECONDS=8.0

# Qwen/Ollama provider
# In Docker Compose this example points to an Ollama instance exposed on the host.
QWEN_NLP_ENDPOINT=http://host.docker.internal:11434/api/generate
QWEN_NLP_MODEL=qwen2.5:7b-instruct
QWEN_API_KEY=
